cabal-version: 3.0
name: solution
version: 1.0.0.0

library
  ghc-options: -Wall
  default-language: Haskell2010
  hs-source-dirs: .
  exposed-modules: Solution
  build-depends:
    base ^>=4.18.3.0,
    containers,

test-suite test
  ghc-options: -Wall
  default-language: Haskell2010
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  build-depends:
    base ^>=4.18.3.0,
    containers,
    hspec,
    solution,
