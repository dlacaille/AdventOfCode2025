cabal-version: 3.0
name: day1
version: 1.0.0.0

common defaults
  ghc-options: -Wall
  default-language: Haskell2010

library
  import: defaults
  hs-source-dirs: lib
  exposed-modules: Lib
  build-depends: base ^>=4.18.3.0

executable puzzle1
  import: defaults
  main-is: Puzzle1.hs
  ghc-options:
    -main-is
    Puzzle1.main

  build-depends:
    base ^>=4.18.3.0,
    day1,

executable puzzle2
  import: defaults
  main-is: Puzzle2.hs
  ghc-options:
    -main-is
    Puzzle2.main

  build-depends:
    base ^>=4.18.3.0,
    day1,

test-suite test
  import: defaults
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  build-depends:
    base ^>=4.18.3.0,
    day1,
    hspec,
