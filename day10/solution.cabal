cabal-version: 3.0
name: solution
version: 1.0.0.0

library
  ghc-options: -Wall -threaded
  default-language: Haskell2010
  hs-source-dirs: .
  exposed-modules: Solution
  build-depends:
    base ^>=4.18.3.0,
    common,
    containers,
    parallel,
    split,
    time,

executable solution
  ghc-options: -Wall -threaded -rtsopts -with-rtsopts=-N8
  default-language: Haskell2010
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
    base ^>=4.18.3.0,
    solution,
    split,

library common
  ghc-options: -Wall
  default-language: Haskell2010
  hs-source-dirs: common
  exposed-modules: Utils
  build-depends:
    base ^>=4.18.3.0,
    containers,

test-suite test
  ghc-options: -Wall
  default-language: Haskell2010
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  build-depends:
    base ^>=4.18.3.0,
    containers,
    hspec,
    solution,
    split,
